{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(webp|jpg|jpeg|png|svg|ico|woff2|woff)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(llms\\.txt|llms-full\\.txt|robots\\.txt|sitemap\\.xml)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/og-image.webp",
      "destination": "/press-kit/banners/og-image.png",
      "permanent": true
    },
    {
      "source": "/favicon.svg",
      "destination": "/images/logo-ascentia-favicon.svg",
      "permanent": true
    },
    {
      "source": "/favicon-48x48.png",
      "destination": "/press-kit/logos/favicon-64.png",
      "permanent": true
    },
    {
      "source": "/favicon.ico",
      "destination": "/press-kit/logos/favicon-32.png",
      "permanent": true
    },
    {
      "source": "/apple-touch-icon.png",
      "destination": "/press-kit/logos/logo-ascentia-icon.png",
      "permanent": true
    },
    {
      "source": "/logo-horizontal.svg",
      "destination": "/images/logo-ascentia-horizontal.svg",
      "permanent": true
    }
  ]
}
